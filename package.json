{
  "name": "phonefix-profitcalculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:extension": "tsc --noEmit && vite build --config vite.extension.config.ts && vite build --config vite.extension-content.config.ts",
    "preview": "vite preview --host 0.0.0.0 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "uqr": "^0.1.3"
  }
}
